# Local LLM (Ollama-compatible)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:latest
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=300

# Model routing roles
MODEL_FAST=qwen2.5:3b
MODEL_STRONG=llama3.1:latest
MODEL_CLOUD=
MODEL_VISION=llava:7b
# Display label for local Diffusers SDXL (not an Ollama model name)
MODEL_IMAGE=sdxl-local

# Local SDXL checkpoint (Diffusers). Leave unset to auto-use
# models/checkpoints/sd_xl_base_1.0.safetensors when that file exists.
# MODEL_IMAGE_PATH=D:/multeagent/models/checkpoints/sd_xl_base_1.0.safetensors
IMAGE_WIDTH=768
IMAGE_HEIGHT=768
# fast | balanced | quality — sets default steps/guidance/strength
IMAGE_PROFILE=fast
# Optional hard overrides (win over profile when set):
# IMAGE_STEPS=16
# IMAGE_GUIDANCE=5.5
# IMAGE_STRENGTH=0.4
IMAGE_NEGATIVE_PROMPT=lowres, blurry, distorted, watermark, text, logo, deformed, ugly
IMAGE_PROMPT_POLISH=true
IMAGE_WARM_ON_START=true
IMAGE_UNLOAD_OLLAMA=true
# Faster VAE decode (downloads taesdxl on first use)
IMAGE_TINY_VAE=false
IMAGE_SLOTS=1

# Optional remote OpenAI-compatible backend (cloud hybrid)
REMOTE_LLM_BASE_URL=
REMOTE_LLM_API_KEY=

# Database — SQLite by default; Postgres for team/cloud
# DATABASE_URL=sqlite:///D:/multeagent/data/multeagent.db
# DATABASE_URL=postgresql+psycopg://multeagent:multeagent@localhost:5432/multeagent

# Auth
JWT_SECRET=change-me-multeagent-dev-secret-32b+
JWT_EXPIRE_MINUTES=720
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
SSO_ENABLED=false

# Fair scheduling
LLM_SLOTS=1
MAX_ACTIVE_JOBS_PER_USER=1
QUEUE_DEPTH_LIMIT=40
OVERFLOW_WAIT_SECONDS=45

# Tools / artifacts
HTTP_ALLOWLIST=localhost,127.0.0.1,ollama.com,raw.githubusercontent.com
ARTIFACTS_DIR=artifacts
LOG_DIR=logs

# API bind (0.0.0.0 for LAN team access)
API_HOST=0.0.0.0
API_PORT=8787
