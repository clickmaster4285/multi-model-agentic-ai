# Local LLM (Ollama-compatible)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:latest
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=300

# Model routing roles
MODEL_FAST=qwen2.5:3b
MODEL_STRONG=llama3.1:latest
MODEL_CLOUD=
MODEL_VISION=llava:7b
MODEL_IMAGE=

# Optional remote OpenAI-compatible backend (cloud hybrid)
REMOTE_LLM_BASE_URL=
REMOTE_LLM_API_KEY=

# Database — SQLite by default; Postgres for team/cloud
# DATABASE_URL=sqlite:///D:/multeagent/data/multeagent.db
# DATABASE_URL=postgresql+psycopg://multeagent:multeagent@localhost:5432/multeagent

# Auth
JWT_SECRET=change-me-multeagent-dev-secret-32b+
JWT_EXPIRE_MINUTES=720
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
SSO_ENABLED=false

# Fair scheduling
LLM_SLOTS=1
MAX_ACTIVE_JOBS_PER_USER=1
QUEUE_DEPTH_LIMIT=40
OVERFLOW_WAIT_SECONDS=45

# Tools / artifacts
HTTP_ALLOWLIST=localhost,127.0.0.1,ollama.com,raw.githubusercontent.com
ARTIFACTS_DIR=artifacts
LOG_DIR=logs

# API bind (0.0.0.0 for LAN team access)
API_HOST=0.0.0.0
API_PORT=8787
